DB_HOST=localhost
DB_PORT=5433
DB_NAME=<db_name>
DB_USER=<db_user>
DB_PASSWORD=<db_password>
# Generate an example value with: `openssl rand -base64 64`
JWT_SECRET=<safe_jwt_secret>
PGRES_CONTAINER_NAME=postgres_container
API_PORT=3000

# Test database (e2e profile) — copy this block to .env
TEST_DB_HOST=localhost
TEST_DB_PORT=5434
TEST_DB_NAME=cae_e2e
TEST_DB_USER=<test_db_user>
TEST_DB_PASSWORD=<test_db_password>
TEST_PGRES_CONTAINER_NAME=postgres_test_container